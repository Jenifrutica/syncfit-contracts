{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncfit.edge/schemas/adapted-routine.schema.json",
  "title": "AdaptedRoutine",
  "description": "Structured, adapted training prescription produced by the reasoning layer and delivered to the frontend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "phase_inferred",
    "fatigue_level",
    "k_load_multiplier",
    "alerts",
    "adapted_routine"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "session_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "phase_inferred": { "$ref": "common.schema.json#/$defs/InferredPhase" },
    "fatigue_level": { "$ref": "common.schema.json#/$defs/FatigueLevel" },
    "k_load_multiplier": {
      "type": "number",
      "description": "Deterministic load multiplier computed by syncfit-core. The reasoning layer must not alter it.",
      "minimum": 0.7,
      "maximum": 1.05
    },
    "alerts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "adapted_routine": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ExerciseAdaptation" }
    }
  }
}
