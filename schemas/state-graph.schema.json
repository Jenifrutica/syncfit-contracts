{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncfit.edge/schemas/state-graph.schema.json",
  "title": "PhysiologicalStateGraph",
  "description": "Directed State Graph of physiological states: menstrual cycle phases and gestational trimesters, with weighted probabilistic edges for irregularities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/PhysiologicalState" },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/StateTransition" }
    }
  }
}
