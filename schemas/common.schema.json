{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncfit.edge/schemas/common.schema.json",
  "title": "SyncFit Common Definitions",
  "description": "Shared definitions reused by every SyncFit Edge contract.",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "description": "Semantic version of the contract this payload conforms to.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 / RFC 3339 UTC timestamp."
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Modality": {
      "type": "string",
      "description": "Physiological modality selected by the athlete.",
      "enum": ["MENSTRUAL_CYCLE", "GESTATIONAL"]
    },
    "CyclePhase": {
      "type": "string",
      "enum": ["MENSTRUAL", "FOLLICULAR", "OVULATORY", "LUTEAL"]
    },
    "Trimester": {
      "type": "string",
      "enum": ["TRIMESTER_1", "TRIMESTER_2", "TRIMESTER_3"]
    },
    "InferredPhase": {
      "type": "string",
      "description": "Phase of the menstrual cycle or gestational trimester inferred by the system.",
      "enum": [
        "MENSTRUAL",
        "FOLLICULAR",
        "OVULATORY",
        "LUTEAL",
        "TRIMESTER_1",
        "TRIMESTER_2",
        "TRIMESTER_3"
      ]
    },
    "FatigueLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "AlertSeverity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "CRITICAL"]
    },
    "Biomarkers": {
      "type": "object",
      "description": "Basal and neuromuscular biomarkers sampled at the edge.",
      "additionalProperties": false,
      "required": [
        "delta_temperature_c",
        "rmssd_hrv_ms",
        "isometric_force_loss_pct"
      ],
      "properties": {
        "delta_temperature_c": {
          "type": "number",
          "description": "Skin thermal variation relative to the individual baseline, in Celsius.",
          "minimum": -2.0,
          "maximum": 2.0
        },
        "rmssd_hrv_ms": {
          "type": "number",
          "description": "Root mean square of successive R-R differences, in milliseconds.",
          "minimum": 0,
          "maximum": 300
        },
        "isometric_force_loss_pct": {
          "type": "number",
          "description": "Percentage of isometric strength lost versus baseline, from the load cell.",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "ExerciseAdaptation": {
      "type": "object",
      "description": "Adaptation applied to a single programmed exercise.",
      "additionalProperties": false,
      "required": [
        "exercise_original",
        "blocked",
        "block_reason",
        "exercise_substitute",
        "series_adapted",
        "reps_adapted",
        "weight_suggested_kg"
      ],
      "properties": {
        "exercise_original": { "type": "string" },
        "blocked": { "type": "boolean" },
        "block_reason": {
          "type": "string",
          "description": "Empty string when the exercise is not blocked."
        },
        "exercise_substitute": {
          "type": "string",
          "description": "Empty string when no substitution is required."
        },
        "series_adapted": { "type": "integer", "minimum": 0, "maximum": 20 },
        "reps_adapted": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weight_suggested_kg": { "type": "number", "minimum": 0 },
        "exercise_id": {
          "type": "string",
          "description": "Catalog id of the recommended exercise, when known."
        },
        "muscle_groups": {
          "type": "array",
          "description": "Muscle groups targeted by the exercise.",
          "items": { "$ref": "#/$defs/MuscleGroup" }
        },
        "impact": { "$ref": "#/$defs/ExerciseImpact" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "image_url": {
          "type": "string",
          "description": "Free-use illustration of the exercise (may be a placeholder for now)."
        },
        "media_url": {
          "type": ["string", "null"],
          "description": "Reserved for demonstration videos/animations; null until available."
        },
        "role": { "$ref": "#/$defs/ExerciseRole" },
        "rest_seconds": {
          "type": "integer",
          "description": "Default rest between effective sets, in seconds.",
          "minimum": 0,
          "maximum": 600
        },
        "estimated_seconds": {
          "type": "integer",
          "description": "Estimated time to complete all sets of this exercise, including rests.",
          "minimum": 0
        },
        "sets": {
          "type": "array",
          "description": "Warm-up/activation, approximation and effective sets.",
          "items": { "$ref": "#/$defs/SetPrescription" }
        }
      }
    },
    "PhysiologicalState": {
      "type": "object",
      "description": "Node of the Directed State Graph.",
      "additionalProperties": false,
      "required": ["id", "state", "kind", "label"],
      "properties": {
        "id": { "type": "string" },
        "state": { "$ref": "#/$defs/InferredPhase" },
        "kind": { "type": "string", "enum": ["CYCLE_PHASE", "TRIMESTER"] },
        "label": { "type": "string" }
      }
    },
    "StateTransition": {
      "type": "object",
      "description": "Weighted, directed edge of the Directed State Graph.",
      "additionalProperties": false,
      "required": ["from", "to", "weight"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "weight": {
          "type": "number",
          "description": "Transition probability in [0, 1]; below 1 models irregularity.",
          "minimum": 0,
          "maximum": 1
        },
        "condition": {
          "type": "string",
          "description": "Optional human-readable condition guarding the transition."
        }
      }
    },
    "Language": {
      "type": "string",
      "description": "Output/UI language. More languages may be added over time.",
      "enum": ["EN", "ES", "ZH"]
    },
    "LocalizedText": {
      "type": "object",
      "description": "Text localized by language code. English is always required; other languages are optional and extensible.",
      "required": ["en"],
      "additionalProperties": { "type": "string" }
    },
    "MuscleGroup": {
      "type": "string",
      "description": "Target muscle group. Includes isolated groups, full-body regions and movement patterns for combinations.",
      "enum": [
        "GLUTES",
        "QUADRICEPS",
        "HAMSTRINGS",
        "CALVES",
        "ADDUCTORS",
        "ABDUCTORS",
        "ABS",
        "OBLIQUES",
        "LOWER_BACK",
        "UPPER_BACK",
        "BACK",
        "LATS",
        "CHEST",
        "SHOULDERS",
        "BICEPS",
        "TRICEPS",
        "FOREARMS",
        "ARMS",
        "FULL_LEG",
        "CORE",
        "UPPER_BODY",
        "LOWER_BODY",
        "FULL_BODY",
        "PUSH",
        "PULL"
      ]
    },
    "ExerciseImpact": {
      "type": "string",
      "description": "Joint/impact stress of an exercise, used by the biomechanical safety rules.",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "ExerciseRole": {
      "type": "string",
      "description": "Role of an exercise inside a routine.",
      "enum": ["WARMUP", "ACTIVATION", "MAIN"]
    },
    "SetType": {
      "type": "string",
      "description": "Type of set: warm-up/activation, approximation, or effective working set.",
      "enum": ["WARMUP", "ACTIVATION", "APPROXIMATION", "EFFECTIVE"]
    },
    "EnergyLevel": {
      "type": "string",
      "description": "Subjective energy reported by the athlete before training.",
      "enum": ["ENERGY", "MODERATE", "NO_ENERGY"]
    },
    "UserObjective": {
      "type": "string",
      "description": "Training/nutrition objective selected by the athlete.",
      "enum": [
        "STRENGTH",
        "HYPERTROPHY",
        "FAT_LOSS",
        "HEALTH",
        "RECOVERY",
        "PERFORMANCE",
        "GESTATIONAL_HEALTH"
      ]
    },
    "SupplementSafety": {
      "type": "string",
      "description": "Safety of a supplement for the current context (e.g. pregnancy).",
      "enum": ["SAFE", "CAUTION", "AVOID"]
    },
    "SupplementCategory": {
      "type": "string",
      "enum": [
        "VITAMIN",
        "MINERAL",
        "PROTEIN",
        "OMEGA3",
        "CAFFEINE",
        "CREATINE",
        "IRON",
        "FOLATE",
        "CALCIUM",
        "FIBER",
        "ELECTROLYTES",
        "OTHER"
      ]
    },
    "MacroNutrients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protein_g", "carbs_g", "fat_g", "kcal"],
      "properties": {
        "protein_g": { "type": "number", "minimum": 0 },
        "carbs_g": { "type": "number", "minimum": 0 },
        "fat_g": { "type": "number", "minimum": 0 },
        "kcal": { "type": "number", "minimum": 0 }
      }
    },
    "SetPrescription": {
      "type": "object",
      "description": "A single set with type, load, rest and estimated duration.",
      "additionalProperties": false,
      "required": ["type", "reps", "weight_kg", "rest_seconds", "estimated_seconds"],
      "properties": {
        "type": { "$ref": "#/$defs/SetType" },
        "reps": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weight_kg": { "type": "number", "minimum": 0 },
        "rest_seconds": { "type": "integer", "minimum": 0, "maximum": 600 },
        "tempo": { "type": "string" },
        "estimated_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "ExerciseLoad": {
      "type": "object",
      "description": "A load the athlete normally lifts for an exercise (baseline).",
      "additionalProperties": false,
      "required": ["exercise_id", "weight_kg"],
      "properties": {
        "exercise_id": { "type": "string" },
        "weight_kg": { "type": "number", "minimum": 0 },
        "reps": { "type": "integer", "minimum": 1, "maximum": 100 },
        "machine_id": { "type": "string" },
        "unit": { "type": "string", "enum": ["KG", "LB", "LEVEL", "PLATES", "BODYWEIGHT"] }
      }
    },
    "EquipmentType": {
      "type": "string",
      "description": "How an exercise is loaded: free weight, machine, smith, cable, bodyweight, assisted or band.",
      "enum": ["FREE_WEIGHT", "MACHINE", "SMITH", "CABLE", "BODYWEIGHT", "ASSISTED", "BAND", "NONE"]
    },
    "GoalPhase": {
      "type": "string",
      "description": "Current training/nutrition goal phase; can change over time.",
      "enum": ["VOLUME", "DEFINITION", "MAINTENANCE", "STRENGTH_FOCUS", "RECOVERY"]
    },
    "SupplementFrequency": {
      "type": "string",
      "description": "When a supplement is taken; DAILY ones get an intake reminder.",
      "enum": ["DAILY", "PRE_WORKOUT", "POST_WORKOUT", "AS_NEEDED"]
    }
  }
}
